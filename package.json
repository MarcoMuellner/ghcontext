{
  "name": "ghcontext",
  "version": "1.0.1",
  "description": "GitHub Context Provider for LLMs - Access GitHub content through MCP",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "ghcontext": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .js,.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepublishOnly": "pnpm run lint && pnpm run test && pnpm run build"
  },
  "keywords": [
    "github",
    "api",
    "context",
    "llm",
    "mcp",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.5.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "@octokit/graphql": "^8.2.2",
    "@octokit/rest": "^21.1.1",
    "dotenv": "^16.5.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.14.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "fetch-mock": "^12.5.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1",
    "vitest": "^3.1.1"
  }
}
